# Environment Variables — Nutravoe
# Copy this file to .env.local and fill in your values.

# ─── Sanity (CMS) ─────────────────────────────────────────────────
# Get these from sanity.io → your project → API settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# Shared secret for Sanity webhook → POST /api/revalidate (Authorization: Bearer <value>)
SANITY_REVALIDATE_SECRET=

# ─── Supabase (orders database) ───────────────────────────────────
# Get these from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Canonical production site URL used for SEO metadata, sitemap, and absolute URLs
NEXT_PUBLIC_SITE_URL=
# Google Search Console verification token from the HTML tag method
GOOGLE_SITE_VERIFICATION=

# ─── Ola Maps (Krutrim) — geocoding, directions / road distance, autocomplete ─
# Get an API key from Ola Maps; whitelist your domains (localhost, production, Vercel preview).
# If unset, geocoding falls back to Google Maps then Nominatim; delivery distance falls back to Google Routes then haversine.
# https://maps.olakrutrim.com/docs/auth
OLA_MAPS_API_KEY=
# Same key as OLA_MAPS_API_KEY — required in the browser for Ola vector map tiles (MapPicker).
# Domain allowlist must include every origin users open (browser sends Origin), e.g.:
#   http://localhost:3001   https://nutravoe.in   https://www.nutravoe.in
# If production is missing, Ola returns "Domain … is not allowed" and MapPicker falls back to Google.
NEXT_PUBLIC_OLA_MAPS_API_KEY=
# Optional: override Ola vector style URL (default: default-light-lite, 2D-only).
# Avoid default-light-standard — it includes 3D building layers that break MapLibre in the browser.
# NEXT_PUBLIC_OLA_MAPS_STYLE_URL=https://api.olamaps.io/tiles/vector/v1/styles/default-light-lite/style.json?key=0.4.0
# Browser fallback when Ola tiles fail in MapPicker (enable Maps JavaScript API; HTTP referrer allowlist).
# Can be the same key as GOOGLE_MAPS_API_KEY with both server + browser restrictions configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Canonical site URL (https://nutravoe.in or your Vercel production URL). Used as a fallback Referer
# for server-side Ola calls when the request host (e.g. a preview *.vercel.app) is not allowlisted,
# and to align road-distance pricing with production. Set this on Vercel for Preview + Production.
# NEXT_PUBLIC_SITE_URL=https://nutravoe.in
# Alternative env name (same key) — supported for compatibility with tooling:
# OLAMAPS_API_KEY=
#
# Server-side calls must send Referer/Origin that match your allowlist (browser keys enforce this).
# `/api/*` routes derive Referer from the incoming Host (any port). Use this only when there is
# no HTTP request (e.g. background jobs) or to override:
# OLA_MAPS_HTTP_REFERER=http://localhost:3001/

# ─── Google Maps Platform (OLA fallback) ───────────────────────────
# Server-side (Routes, Geocoding, Places) — keep this key server-only if possible.
GOOGLE_MAPS_API_KEY=
# Browser map tiles (MapPicker). Must allow Maps JavaScript API on this key.
# If GOOGLE_MAPS_API_KEY is restricted to Routes/Geocoding/Places only, MapPicker gets
# ApiTargetBlockedMapError — use a separate browser key or add Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID for Advanced Markers (defaults to DEMO_MAP_ID). Create at Cloud Console → Map Management.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Enable in Cloud Console: Routes API, Geocoding API, Places API, Maps JavaScript API.
# Browser key → Application restriction: HTTP referrers (localhost + nutravoe.in).
# https://console.cloud.google.com/google/maps-apis/credentials

# ─── Razorpay (payments) ──────────────────────────────────────────
# Get these from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# This is safe to expose in the browser (it's the public key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
